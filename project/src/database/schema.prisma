  @@index([featureName])
  @@index([enabled])
}

model SystemMaintenance {
  id              String   @id @default(uuid()) @db.Uuid
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  startTime       DateTime
  endTime         DateTime
  maintenanceType String   @db.VarChar(100)
  notifyUsers     Boolean  @default(true)
  createdBy       String?  @db.Uuid

  @@index([startTime])
  @@index([maintenanceType])
