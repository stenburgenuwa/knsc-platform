// ============================================================================
// Test Case and Defect Management
// ============================================================================

model TestCase {
  id              String   @id @default(uuid()) @db.Uuid
  module          String   @db.VarChar(100)
  testCaseNumber  String   @unique @db.VarChar(50)
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  expectedResult  String?  @db.Text
  priority        String   @db.VarChar(20)
  automated       Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Relationships
  executions      TestExecution[]

  @@index([module])
  @@index([priority])
}

model TestExecution {
  id              String   @id @default(uuid()) @db.Uuid
  testCaseId      String   @db.Uuid
  executedBy      String?  @db.Uuid
  executionDate   DateTime @default(now())
  result          String   @db.VarChar(20)
  executionTimeMs Int?
  notes           String?  @db.Text

  // Relationships
  testCase        TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([executionDate])
}

model Defect {
  id              String   @id @default(uuid()) @db.Uuid
  defectNumber    String   @unique @db.VarChar(50)
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  module          String   @db.VarChar(100)
  severity        String   @db.VarChar(30)
  priority        String   @db.VarChar(30)
  status          String   @db.VarChar(30) @default("Open")
  assignedTo      String?  @db.Uuid
  reportedBy      String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([defectNumber])
  @@index([status])
  @@index([module])
  @@index([severity])
}
