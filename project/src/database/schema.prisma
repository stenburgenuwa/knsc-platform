// ============================================================================
// CHAPTER 10: FINANCIAL MANAGEMENT & PAYMENTS
// ============================================================================

model PaymentMethod {
  id              String   @id @default(uuid()) @db.Uuid
  methodName      String   @db.VarChar(100)
  provider        String   @db.VarChar(100)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Invoice {
  id              String   @id @default(uuid()) @db.Uuid
  invoiceNumber   String   @unique @db.VarChar(50)
  customerType    String   @db.VarChar(50)
  customerId      String?  @db.Uuid
  invoiceDate     DateTime @db.Date
  dueDate         DateTime @db.Date
  subtotal        Decimal  @db.Decimal(12, 2)
  taxAmount       Decimal? @db.Decimal(12, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)
  currency        String   @db.VarChar(10) @default("KES")
  invoiceStatus   String   @db.VarChar(30) @default("Draft")
  createdBy       String?  @db.Uuid
  createdAt       DateTime @default(now())

  // Relationships
  payments        Payment[]

  @@index([invoiceNumber])
  @@index([invoiceStatus])
  @@index([customerId])
  @@index([dueDate])
}

model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  invoiceId       String   @db.Uuid
  paymentMethodId String?  @db.Uuid
  payerName       String   @db.VarChar(255)
  payerPhone      String?  @db.VarChar(30)
  transactionReference String @unique @db.VarChar(100)
  amountPaid      Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime @default(now())
  paymentStatus   String   @db.VarChar(30) @default("Pending")
  verifiedBy      String?  @db.Uuid
  verifiedAt      DateTime?

  // Relationships
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  receipts        Receipt[]

  @@index([invoiceId])
  @@index([paymentStatus])
  @@index([transactionReference])
}

model Receipt {
  id              String   @id @default(uuid()) @db.Uuid
  receiptNumber   String   @unique @db.VarChar(50)
  paymentId       String   @db.Uuid
  receiptDate     DateTime @default(now())
  issuedBy        String?  @db.Uuid
  receiptUrl      String?  @db.Text

  // Relationships
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([receiptNumber])
  @@index([paymentId])
}

model ClubFee {
  id              String   @id @default(uuid()) @db.Uuid
  clubId          String   @db.Uuid
  seasonId        String   @db.Uuid
  feeType         String   @db.VarChar(100)
  amount          Decimal  @db.Decimal(12, 2)
  dueDate         DateTime @db.Date
  paymentStatus   String   @db.VarChar(30) @default("Pending")

  // Relationships
  club            Club     @relation(fields: [clubId], references: [id])
  season          Season   @relation(fields: [seasonId], references: [id])

  @@index([clubId])
  @@index([seasonId])
  @@index([paymentStatus])
}

model DisciplinaryFine {
  id              String   @id @default(uuid()) @db.Uuid
  clubId          String?  @db.Uuid
  playerId        String?  @db.Uuid
  refereeId       String?  @db.Uuid
  offence         String   @db.Text
  fineAmount      Decimal  @db.Decimal(12, 2)
  imposedBy       String?  @db.Uuid
  decisionDate    DateTime @db.Date
  paymentStatus   String   @db.VarChar(30) @default("Pending")

  // Relationships
  club            Club?    @relation(fields: [clubId], references: [id])
  player          Player?  @relation(fields: [playerId], references: [id])
  referee         Referee? @relation(fields: [refereeId], references: [id])

  @@index([clubId])
  @@index([playerId])
  @@index([refereeId])
}

model SponsorshipRevenue {
  id              String   @id @default(uuid()) @db.Uuid
  sponsorName     String   @db.VarChar(255)
  sponsorshipLevel String  @db.VarChar(100)
  contractValue   Decimal  @db.Decimal(14, 2)
  amountReceived  Decimal  @db.Decimal(14, 2)
  balance         Decimal  @db.Decimal(14, 2)
  contractStart   DateTime @db.Date
  contractEnd     DateTime @db.Date

  @@index([sponsorName])
}

model Donation {
  id              String   @id @default(uuid()) @db.Uuid
  donorName       String   @db.VarChar(255)
  donorType       String   @db.VarChar(100)
  amount          Decimal  @db.Decimal(12, 2)
  purpose         String?  @db.Text
  donationDate    DateTime @db.Date
  receiptId       String?  @db.Uuid

  @@index([donorType])
  @@index([donationDate])
}

model FinancialLedger {
  id              String   @id @default(uuid()) @db.Uuid
  transactionDate DateTime
  transactionType String   @db.VarChar(100)
  referenceTable  String   @db.VarChar(100)
  referenceId     String?  @db.Uuid
  debit           Decimal? @db.Decimal(14, 2)
  credit          Decimal? @db.Decimal(14, 2)
  balance         Decimal  @db.Decimal(14, 2)
  narration       String?  @db.Text
  createdBy       String?  @db.Uuid

  @@index([transactionDate])
  @@index([transactionType])
  @@index([referenceTable])
}

model Refund {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @db.Uuid
  refundAmount    Decimal  @db.Decimal(12, 2)
  refundReason    String?  @db.Text
  approvedBy      String?  @db.Uuid
  refundDate      DateTime @default(now())
  refundStatus    String   @db.VarChar(30) @default("Pending")

  // Relationships
  payment         Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([refundStatus])
}

