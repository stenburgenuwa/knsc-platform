// KNSCL Football Management Platform - Prisma Schema
// This schema implements the complete database architecture defined in 01_DATABASE.md

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// CHAPTER 1: IDENTITY & ACCESS MANAGEMENT
// ============================================================================

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  firstName           String    @db.VarChar(100)
  middleName          String?   @db.VarChar(100)
  lastName            String    @db.VarChar(100)
  email               String    @unique @db.VarChar(255)
  phoneNumber         String    @unique @db.VarChar(20)
  passwordHash        String    @db.Text
  profilePhoto        String?   @db.Text
  nationalId          String?   @db.VarChar(30)
  gender              String?   @db.VarChar(20)
  dateOfBirth         DateTime? @db.Date
  isEmailVerified     Boolean   @default(false)
  isPhoneVerified     Boolean   @default(false)
  isActive            Boolean   @default(true)
  isLocked            Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  createdBy           String?   @db.Uuid
  updatedBy           String?   @db.Uuid
  deletedBy           String?   @db.Uuid

  // Relationships
  roles               UserRole[]
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  loginHistory        LoginHistory[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  createdByUser       User?     @relation("CreatedBy", fields: [createdBy], references: [id])
  updatedByUser       User?     @relation("UpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser       User?     @relation("DeletedBy", fields: [deletedBy], references: [id])
  usersByCreated      User[]    @relation("CreatedBy")
  usersByUpdated      User[]    @relation("UpdatedBy")
  usersByDeleted      User[]    @relation("DeletedBy")
  teamManager         TeamManager?
  referee             Referee?
  notificationPreferences UserNotificationPreferences?

  @@index([email])
  @@index([phoneNumber])
  @@index([isActive])
  @@index([lastLoginAt])
}

model Role {
  id            String   @id @default(uuid()) @db.Uuid
  roleName      String   @unique @db.VarChar(100)
  description   String?  @db.Text
  isSystemRole  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  userRoles     UserRole[]
  permissions   RolePermission[]
}

model Permission {
  id              String   @id @default(uuid()) @db.Uuid
  permissionName  String   @unique @db.VarChar(150)
  module          String   @db.VarChar(100)
  description     String?  @db.Text
  createdAt       DateTime @default(now())

  // Relationships
  rolePermissions RolePermission[]

  @@index([module])
}

model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  assignedBy  String?   @db.Uuid
  assignedAt  DateTime  @default(now())
  expiresAt   DateTime?

  // Relationships
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  grantedAt    DateTime @default(now())
  grantedBy    String?  @db.Uuid

  // Relationships
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  deviceName      String?   @db.VarChar(255)
  browser         String?   @db.VarChar(255)
  operatingSystem String?   @db.VarChar(255)
  ipAddress       String?   @db.VarChar(100)
  loginTime       DateTime  @default(now())
  logoutTime      DateTime?
  refreshToken    String?   @db.Text
  isActive        Boolean   @default(true)

  // Relationships
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique @db.Text
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relationships
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model LoginHistory {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String?   @db.Uuid
  emailAttempted  String    @db.VarChar(255)
  ipAddress       String?   @db.VarChar(100)
  browser         String?   @db.VarChar(255)
  operatingSystem String?   @db.VarChar(255)
  success         Boolean
  failureReason   String?   @db.Text
  loginTime       DateTime  @default(now())

  // Relationships
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([emailAttempted])
  @@index([loginTime])
}

model Notification {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  title             String    @db.VarChar(255)
  message           String    @db.Text
  notificationType  String    @db.VarChar(100)
  deliveryChannel   String    @db.VarChar(50)
  isRead            Boolean   @default(false)
  sentAt            DateTime  @default(now())
  readAt            DateTime?

  // Relationships
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([sentAt])
}

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @db.Uuid
  module         String    @db.VarChar(100)
  action         String    @db.VarChar(255)
  entityType     String    @db.VarChar(100)
  entityId       String?   @db.Uuid
  previousValues Json?
  newValues      Json?
  ipAddress      String?   @db.VarChar(100)
  userAgent      String?   @db.Text
  createdAt      DateTime  @default(now())

  // Relationships
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  settingKey  String   @unique @db.VarChar(255)
  settingValue String  @db.Text
  description String?  @db.Text
  updatedBy   String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@index([settingKey])
}

model UserNotificationPreferences {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  smsEnabled        Boolean   @default(true)
  emailEnabled      Boolean   @default(true)
  pushEnabled       Boolean   @default(true)
  inAppEnabled      Boolean   @default(true)
  whatsappEnabled   Boolean   @default(false)
  marketingEnabled  Boolean   @default(false)

  // Relationships
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// CHAPTER 2: COMPETITION & LEAGUE MANAGEMENT
// ============================================================================

model County {
  id            String   @id @default(uuid()) @db.Uuid
  countyCode    String   @unique @db.VarChar(10)
  countyName    String   @unique @db.VarChar(100)
  headquarters  String?  @db.VarChar(150)
  region        String?  @db.VarChar(100)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  // Relationships
  seasons       Season[]
  competitions  Competition[]
  clubs         Club[]
  venues        Venue[]

  @@index([countyName])
  @@index([countyCode])
  @@index([isActive])
}

model Season {
  id                   String   @id @default(uuid()) @db.Uuid
  seasonName           String   @db.VarChar(100)
  startDate            DateTime @db.Date
  endDate              DateTime @db.Date
  registrationDeadline DateTime @db.Date
  fixtureStartDate     DateTime @db.Date
  fixtureEndDate       DateTime @db.Date
  status               String   @db.VarChar(30) @default("Planning")
  countyId             String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relationships
  county               County?  @relation(fields: [countyId], references: [id])
  competitions         Competition[]
  fixtures             Fixture[]
  playerRegistrations  PlayerRegistration[]
  leagueTables         LeagueTable[]
  clubRegistrations    ClubRegistration[]
  playerSeasonStats    PlayerSeasonStatistics[]
  clubSeasonStats      ClubSeasonStatistics[]
  refereeSeasonStats   RefereeSeasonStatistics[]
  playerRankings       PlayerRanking[]
  clubRankings         ClubRanking[]
  seasonSummaries      SeasonSummary[]
  playerDisciplinary   PlayerDisciplinaryHistory[]

  @@index([seasonName])
  @@index([status])
  @@index([countyId])
}

model Competition {
  id              String   @id @default(uuid()) @db.Uuid
  countyId        String   @db.Uuid
  seasonId        String   @db.Uuid
  competitionName String   @db.VarChar(150)
  description     String?  @db.Text
  competitionType String   @db.VarChar(50)
  logoUrl         String?  @db.Text
  status          String   @db.VarChar(30) @default("Draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  county          County   @relation(fields: [countyId], references: [id])
  season          Season   @relation(fields: [seasonId], references: [id])
  divisions       Division[]
  fixtures        Fixture[]
  leagueTables    LeagueTable[]

  @@index([competitionName])
  @@index([countyId])
  @@index([seasonId])
  @@index([status])
}

model Division {
  id               String   @id @default(uuid()) @db.Uuid
  competitionId    String   @db.Uuid
  divisionName     String   @db.VarChar(100)
  level            Int
  maxTeams         Int?
  promotionSlots   Int?
  relegationSlots  Int?
  createdAt        DateTime @default(now())

  // Relationships
  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  leagues          League[]

  @@index([competitionId])
  @@index([level])
}

model League {
  id              String   @id @default(uuid()) @db.Uuid
  divisionId      String   @db.Uuid
  leagueName      String   @db.VarChar(150)
  shortName       String?  @db.VarChar(50)
  description     String?  @db.Text
  totalTeams      Int?
  homeAndAway     Boolean  @default(true)
  pointsWin       Int      @default(3)
  pointsDraw      Int      @default(1)
  pointsLoss      Int      @default(0)
  status          String   @db.VarChar(30) @default("Draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  division        Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  clubs           Club[]
  fixtures        Fixture[]
  leagueTables    LeagueTable[]

  @@index([leagueName])
  @@index([status])
  @@index([divisionId])
}

model Venue {
  id              String   @id @default(uuid()) @db.Uuid
  countyId        String   @db.Uuid
  venueName       String   @db.VarChar(150)
  town            String   @db.VarChar(100)
  ward            String?  @db.VarChar(100)
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  seatingCapacity Int?
  pitchType       String?  @db.VarChar(50)
  changingRooms   Boolean  @default(false)
  floodlights     Boolean  @default(false)
  contactPerson   String?  @db.VarChar(150)
  contactPhone    String?  @db.VarChar(30)
  status          String   @db.VarChar(30) @default("Active")

  // Relationships
  county          County   @relation(fields: [countyId], references: [id])
  fixtures        Fixture[]
  clubHomeVenue   Club[]

  @@index([venueName])
  @@index([countyId])
  @@index([status])
}

model Fixture {
  id                String   @id @default(uuid()) @db.Uuid
  leagueId          String   @db.Uuid
  seasonId          String   @db.Uuid
  venueId           String   @db.Uuid
  homeClubId        String   @db.Uuid
  awayClubId        String   @db.Uuid
  fixtureDate       DateTime @db.Date
  kickoffTime       DateTime @db.Time
  matchday          Int?
  fixtureStatus     String   @db.VarChar(30) @default("Draft")
  postponementReason String? @db.Text
  attendance        Int?
  weatherConditions String?  @db.VarChar(100)
  createdBy         String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  league            League   @relation(fields: [leagueId], references: [id])
  season            Season   @relation(fields: [seasonId], references: [id])
  venue             Venue    @relation(fields: [venueId], references: [id])
  homeClub          Club     @relation("HomeFixtures", fields: [homeClubId], references: [id])
  awayClub          Club     @relation("AwayFixtures", fields: [awayClubId], references: [id])
  teamSheets        TeamSheet[]
  matchReport       MatchReport?
  refereeAssignments RefereeAssignment[]
  matchEvents       MatchEvent[]
  goals             Goal[]
  yellowCards       YellowCard[]
  redCards          RedCard[]
  substitutions     Substitution[]
  matchAttachments  MatchAttachment[]

  @@index([fixtureDate])
  @@index([fixtureStatus])
  @@index([leagueId])
  @@index([seasonId])
  @@index([venueId])
  @@index([homeClubId])
  @@index([awayClubId])
}

// ============================================================================
// CHAPTER 3: CLUB MANAGEMENT
// ============================================================================

model Club {
  id                String   @id @default(uuid()) @db.Uuid
  countyId          String   @db.Uuid
  leagueId          String   @db.Uuid
  clubName          String   @db.VarChar(150)
  shortName         String?  @db.VarChar(50)
  registrationNumber String? @unique @db.VarChar(50)
  yearFounded       Int?
  clubType          String   @db.VarChar(50)
  status            String   @db.VarChar(30) @default("Draft")
  homeVenueId       String?  @db.Uuid
  email             String?  @db.VarChar(255)
  phoneNumber       String?  @db.VarChar(30)
  website           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  createdBy         String?  @db.Uuid
  updatedBy         String?  @db.Uuid
  deletedBy         String?  @db.Uuid

  // Relationships
  county            County   @relation(fields: [countyId], references: [id])
  league            League   @relation(fields: [leagueId], references: [id])
  homeVenue         Venue?   @relation(fields: [homeVenueId], references: [id])
  branding          ClubBranding?
  teamManagers      TeamManager[]
  officials         ClubOfficial[]
  documents         ClubDocument[]
  registrations     ClubRegistration[]
  sponsors          ClubSponsor[]
  history           ClubHistory[]
  players           Player[]
  homeFixtures      Fixture[]  @relation("HomeFixtures")
  awayFixtures      Fixture[]  @relation("AwayFixtures")
  leagueTables      LeagueTable[]
  clubSeasonStats   ClubSeasonStatistics[]

  @@index([clubName])
  @@index([leagueId])
  @@index([countyId])
  @@index([registrationNumber])
  @@index([status])
}

model ClubBranding {
  id              String   @id @default(uuid()) @db.Uuid
  clubId          String   @unique @db.Uuid
  logoUrl         String?  @db.Text
  primaryColor    String?  @db.VarChar(20)
  secondaryColor  String?  @db.VarChar(20)
  accentColor     String?  @db.VarChar(20)
  website         String?  @db.Text
  facebook        String?  @db.Text
  instagram       String?  @db.Text
  xAccount        String?  @db.Text
  youtube         String?  @db.Text
  slogan          String?  @db.Text
  updatedAt       DateTime @updatedAt

  // Relationships
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model TeamManager {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  clubId          String   @db.Uuid
  appointmentDate DateTime @db.Date
  endDate         DateTime? @db.Date
  status          String   @db.VarChar(30) @default("Active")
  createdAt       DateTime @default(now())

  // Relationships
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([userId])
}

model ClubOfficial {
  id              String   @id @default(uuid()) @db.Uuid
  clubId          String   @db.Uuid
  fullName        String   @db.VarChar(150)
  position        String   @db.VarChar(100)
  phoneNumber     String?  @db.VarChar(30)
  email           String?  @db.VarChar(255)
  nationalId      String?  @db.VarChar(30)
  certification   String?  @db.Text
  appointmentDate DateTime @db.Date
  status          String   @db.VarChar(30) @default("Active")
  createdAt       DateTime @default(now())

  // Relationships
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([status])
}

model ClubDocument {
  id                String   @id @default(uuid()) @db.Uuid
  clubId            String   @db.Uuid
  documentType      String   @db.VarChar(100)
  fileName          String   @db.VarChar(255)
  fileUrl           String   @db.Text
  uploadedBy        String?  @db.Uuid
  uploadedAt        DateTime @default(now())
  expiryDate        DateTime? @db.Date
  verificationStatus String  @db.VarChar(30) @default("Pending")

  // Relationships
  club              Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([documentType])
}

model ClubRegistration {
  id               String   @id @default(uuid()) @db.Uuid
  clubId           String   @db.Uuid
  seasonId         String   @db.Uuid
  registrationDate DateTime @db.Date
  registrationFee  Decimal  @db.Decimal(12, 2)
  paymentStatus    String   @db.VarChar(30) @default("Pending")
  approvalStatus   String   @db.VarChar(30) @default("Pending")
  approvedBy       String?  @db.Uuid
  approvedAt       DateTime?

  // Relationships
  club             Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  season           Season   @relation(fields: [seasonId], references: [id])

  @@unique([clubId, seasonId])
  @@index([clubId])
  @@index([seasonId])
  @@index([approvalStatus])
}

model ClubSponsor {
  id               String   @id @default(uuid()) @db.Uuid
  clubId           String   @db.Uuid
  sponsorName      String   @db.VarChar(255)
  sponsorLogo      String?  @db.Text
  sponsorshipLevel String   @db.VarChar(100)
  contractStart    DateTime @db.Date
  contractEnd      DateTime @db.Date
  website          String?  @db.Text

  // Relationships
  club             Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model ClubHistory {
  id              String   @id @default(uuid()) @db.Uuid
  clubId          String   @db.Uuid
  seasonId        String   @db.Uuid
  leaguePosition  Int?
  matchesPlayed   Int      @default(0)
  wins            Int      @default(0)
  draws           Int      @default(0)
  losses          Int      @default(0)
  goalsFor        Int      @default(0)
  goalsAgainst    Int      @default(0)
  points          Int      @default(0)
  trophiesWon     String?  @db.Text

  // Relationships
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  season          Season   @relation(fields: [seasonId], references: [id])

  @@index([clubId])
  @@index([seasonId])
}

// ============================================================================
// CHAPTER 4: PLAYER MANAGEMENT
// ============================================================================

model Player {
  id                        String   @id @default(uuid()) @db.Uuid
  clubId                    String   @db.Uuid
  playerNumber              String   @unique @db.VarChar(30)
  firstName                 String   @db.VarChar(100)
  middleName                String?  @db.VarChar(100)
  lastName                  String   @db.VarChar(100)
  preferredName             String?  @db.VarChar(100)
  gender                    String?  @db.VarChar(20)
  dateOfBirth               DateTime? @db.Date
  nationality               String?  @db.VarChar(100)
  nationalId                String?  @unique @db.VarChar(30)
  passportNumber            String?  @unique @db.VarChar(30)
  phoneNumber               String?  @db.VarChar(30)
  email                     String?  @db.VarChar(255)
  heightCm                  Int?
  weightKg                  Int?
  dominantFoot              String?  @db.VarChar(20)
  profilePhoto              String?  @db.Text
  status                    String   @db.VarChar(30) @default("Draft")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  deletedAt                 DateTime?

  // Relationships
  club                      Club     @relation(fields: [clubId], references: [id])
  registrations             PlayerRegistration[]
  transfers                 PlayerTransfer[] @relation("FromClub")
  transfersTo               PlayerTransfer[] @relation("ToClub")
  medicalRecords            PlayerMedicalRecord?
  emergencyContacts         PlayerEmergencyContact[]
  disciplinaryHistory       PlayerDisciplinaryHistory[]
  statistics                PlayerSeasonStatistics[]
  awards                    PlayerAward[]
  documents                 PlayerDocument[]
  teamSheetPlayers          TeamSheetPlayer[]
  matchEvents               MatchEvent[]
  goalScorer                Goal[] @relation("Scorer")
  goalAssist                Goal[] @relation("Assist")
  yellowCards               YellowCard[]
  redCards                  RedCard[]
  substitutionsOut          Substitution[] @relation("Out")
  substitutionsIn           Substitution[] @relation("In")

  @@index([clubId])
  @@index([playerNumber])
  @@index([status])
}

model PlayerRegistration {
  id               String   @id @default(uuid()) @db.Uuid
  playerId         String   @db.Uuid
  clubId           String   @db.Uuid
  seasonId         String   @db.Uuid
  jerseyNumber     Int?
  playingPosition  String?  @db.VarChar(50)
  registrationDate DateTime @db.Date
  eligibilityStatus String  @db.VarChar(30) @default("Pending")
  approvedBy       String?  @db.Uuid
  approvedAt       DateTime?

  // Relationships
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club             Club     @relation(fields: [clubId], references: [id])
  season           Season   @relation(fields: [seasonId], references: [id])

  @@unique([playerId, clubId, seasonId])
  @@index([playerId])
  @@index([clubId])
  @@index([seasonId])
  @@index([eligibilityStatus])
}

model PlayerPosition {
  id              String   @id @default(uuid()) @db.Uuid
  positionName    String   @unique @db.VarChar(100)
  abbreviation    String?  @db.VarChar(10)
  createdAt       DateTime @default(now())
}

model PlayerTransfer {
  id              String   @id @default(uuid()) @db.Uuid
  playerId        String   @db.Uuid
  fromClubId      String   @db.Uuid
  toClubId        String   @db.Uuid
  transferDate    DateTime @db.Date
  transferType    String   @db.VarChar(50)
  transferFee     Decimal? @db.Decimal(12, 2)
  approvedBy      String?  @db.Uuid
  approvalDate    DateTime?

  // Relationships
  player          Player   @relation("FromClub", fields: [playerId], references: [id], onDelete: Cascade)
  fromClub        Club     @relation(fields: [fromClubId], references: [id])
  toClub          Club     @relation(fields: [toClubId], references: [id])

  @@index([playerId])
  @@index([fromClubId])
  @@index([toClubId])
}

model PlayerMedicalRecord {
  id                String   @id @default(uuid()) @db.Uuid
  playerId          String   @unique @db.Uuid
  bloodGroup        String?  @db.VarChar(10)
  allergies         String?  @db.Text
  chronicConditions String?  @db.Text
  medications       String?  @db.Text
  medicalNotes      String?  @db.Text
  doctorName        String?  @db.VarChar(150)
  lastMedicalDate   DateTime? @db.Date

  // Relationships
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model PlayerEmergencyContact {
  id               String   @id @default(uuid()) @db.Uuid
  playerId         String   @db.Uuid
  fullName         String   @db.VarChar(150)
  relationship     String   @db.VarChar(100)
