  @@index([reportCode])
  @@index([category])
  @@index([active])
}

model ReportExecution {
  id              String   @id @default(uuid()) @db.Uuid
  reportDefinitionId String @db.Uuid
  generatedBy     String?  @db.Uuid
  filters         Json?
  exportFormat    String   @db.VarChar(30)
  fileLocation    String?  @db.Text
  executionTimeMs Int?
  generatedAt     DateTime @default(now())

  // Relationships
  reportDefinition ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)

  @@index([reportDefinitionId])
  @@index([generatedAt])
}

model DashboardWidget {
