}

model ScheduledReport {
  id              String   @id @default(uuid()) @db.Uuid
  reportDefinitionId String @db.Uuid
  scheduleType    String   @db.VarChar(50)
  scheduleExpression String @db.VarChar(255)
  recipients      Json
  exportFormat    String   @db.VarChar(30)
  enabled         Boolean  @default(true)

  @@index([reportDefinitionId])
  @@index([enabled])
}

