# KNSCL Platform Environment Configuration

# Application
NODE_ENV=production
PORT=3000
APP_URL=https://knscl.ke

# Database
DATABASE_URL=postgresql://knscl_user:CHANGE_ME@db.example.com:5432/knscl_prod
DB_USER=knscl_user
DB_PASSWORD=CHANGE_ME
DB_NAME=knscl_prod
DB_HOST=db.example.com
DB_PORT=5432

# Authentication
JWT_SECRET=CHANGE_ME_WITH_STRONG_SECRET
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d
SESSION_SECRET=CHANGE_ME_WITH_STRONG_SECRET

# Redis
REDIS_URL=redis://redis.example.com:6379
REDIS_PASSWORD=CHANGE_ME

# File Storage
UPLOAD_DIR=/var/uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# SMS Configuration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1234567890

# Email Configuration
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@knscl.ke

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/logs/knscl.log

# Monitoring
SENTRY_DSN=https://example@sentry.io/12345
DATADOG_API_KEY=CHANGE_ME

# Security
CORS_ORIGIN=https://knscl.ke
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Domain Configuration
MAIN_DOMAIN=knscl.ke
ADMIN_DOMAIN=admin.knscl.ke
API_DOMAIN=api.knscl.ke

# SSL
SSL_CERT_PATH=/etc/ssl/certs/knscl.crt
SSL_KEY_PATH=/etc/ssl/private/knscl.key
