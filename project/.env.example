# Copy this file to .env for local development.
# In Vercel, set these as Project Environment Variables instead of committing a file.

# Postgres connection string. Locally: your own Postgres instance.
# In production: the connection string from Neon / Vercel Postgres / your managed provider.
DATABASE_URL="postgresql://user:password@localhost:5432/knscl"

# Secret used to sign login JWTs. Generate a real one for production, e.g.:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# Base URL the frontend uses to call the API.
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
