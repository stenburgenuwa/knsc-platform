/**
 * Environment Configuration Template
 * Copy to .env.local and update with actual values
 */

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/knscl_db"

# JWT Configuration
JWT_SECRET="your-very-long-secret-key-min-32-chars-change-in-production"
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
APP_NAME="KNSCL Platform"
APP_VERSION="1.0.0"

# SMTP (for email notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@knscl.local"

# SMS Provider (Africa's Talking or Twilio)
SMS_PROVIDER="africas-talking"
SMS_API_KEY="your-api-key"
SMS_USERNAME="your-username"

# Authentication Settings
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL_CHAR=true

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
REMEMBER_ME_DURATION_DAYS=30

# Logging
LOG_LEVEL="info"
LOG_FORMAT="json"

# Security
CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS=true
CSRF_PROTECTION=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Third-party integrations
SENTRY_DSN=""
DATADOG_API_KEY=""
