// Kilifi North Sub County League — lean schema covering exactly what the
// public site and the 5 role dashboards read and write. Trimmed down from an
// earlier 100+ table draft that had drifted out of sync with the app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_OWNER
  LEAGUE_MANAGER
  TEAM_MANAGER
  REFEREE
  REFEREE_MANAGER
}

enum FixtureStatus {
  UPCOMING
  COMPLETED
  POSTPONED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  DECLINED
  COMPLETED
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
}

enum Availability {
  AVAILABLE
  UNAVAILABLE
  ON_LEAVE
  INJURED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum TeamSheetRole {
  STARTER
  SUBSTITUTE
}

enum DisciplinaryStatus {
  OPEN
  RESOLVED
  APPEALED
}

enum AnnouncementPriority {
  NORMAL
  HIGH
  EMERGENCY
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                Role
  clubId              String?
  club                Club?         @relation(fields: [clubId], references: [id])
  availability        Availability? // only meaningful for REFEREE accounts
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  refereeAssignments RefereeAssignment[]
  announcements      Announcement[]
  auditLogs          AuditLog[]

  @@index([role])
  @@index([clubId])
}

model Venue {
  id        String    @id @default(uuid())
  name      String
  location  String?
  fixtures  Fixture[]
  homeClubs Club[]
}

model Club {
  id          String   @id @default(uuid())
  name        String
  shortName   String?
  yearFounded Int?
  homeVenueId String?
  homeVenue   Venue?   @relation(fields: [homeVenueId], references: [id])
  logoUrl     String?  @db.Text
  bannerUrl   String?  @db.Text
  colours     String?
  history     String?  @db.Text
  featured    Boolean  @default(false)
  email       String?
  phone       String?
  createdAt   DateTime @default(now())

  players           Player[]
  managers          User[]
  homeFixtures      Fixture[]          @relation("HomeClub")
  awayFixtures      Fixture[]          @relation("AwayClub")
  teamSheets        TeamSheet[]
  disciplinaryCases DisciplinaryCase[]

  @@index([name])
}

model Player {
  id                     String    @id @default(uuid())
  clubId                 String
  club                   Club      @relation(fields: [clubId], references: [id])
  firstName              String
  middleName             String?
  lastName               String
  playerNumber           Int?
  position               String?
  dateOfBirth            DateTime?
  photoUrl               String?   @db.Text
  // Private: never returned by the public data layer (see lib/public-data.ts).
  idNumber               String?
  height                 Float?
  weight                 Float?
  county                 String?
  preferredFoot          String?
  featured               Boolean   @default(false)
  goals                  Int       @default(0)
  approved               Boolean   @default(true)
  // KNSCL registration number is only assigned once both approvals below are
  // true — see lib/player-registration.ts, which draws from a DB sequence so
  // it stays unique even under concurrent approvals.
  registrationNumber     String?   @unique
  leagueManagerApproved  Boolean   @default(false)
  platformOwnerApproved  Boolean   @default(false)
  // Set when a League Manager rejects a registration. The reason is shown to
  // the Team Manager, who corrects the record and resubmits — which clears
  // both fields. A rejection never clears an already-issued registration
  // number: numbers are permanent once assigned.
  rejectionReason        String?   @db.Text
  rejectedAt             DateTime?
  createdAt              DateTime  @default(now())

  matchEvents       MatchEvent[]
  teamSheetEntries  TeamSheetEntry[]
  disciplinaryCases DisciplinaryCase[]

  @@index([clubId])
}

model Fixture {
  id                String        @id @default(uuid())
  homeClubId        String
  awayClubId        String
  homeClub          Club          @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub          Club          @relation("AwayClub", fields: [awayClubId], references: [id])
  venueId           String?
  venue             Venue?        @relation(fields: [venueId], references: [id])
  fixtureDate       DateTime
  kickoffTime       String?
  round             String?
  featured          Boolean       @default(false)
  status            FixtureStatus @default(UPCOMING)
  homeScore         Int?
  awayScore         Int?
  reportStatus      ReportStatus  @default(DRAFT)
  reportSubmittedAt DateTime?
  reportNotes       String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refereeAssignment RefereeAssignment?
  matchEvents       MatchEvent[]
  teamSheets        TeamSheet[]
  disciplinaryCases DisciplinaryCase[]

  @@index([status])
  @@index([fixtureDate])
  @@index([homeClubId])
  @@index([awayClubId])
}

model MatchEvent {
  id        String         @id @default(uuid())
  fixtureId String
  fixture   Fixture        @relation(fields: [fixtureId], references: [id])
  playerId  String
  player    Player         @relation(fields: [playerId], references: [id])
  type      MatchEventType
  minute    Int?
  createdAt DateTime       @default(now())

  @@index([fixtureId])
  @@index([playerId])
}

model RefereeAssignment {
  id        String           @id @default(uuid())
  fixtureId String           @unique
  fixture   Fixture          @relation(fields: [fixtureId], references: [id])
  refereeId String
  referee   User             @relation(fields: [refereeId], references: [id])
  status    AssignmentStatus @default(ASSIGNED)
  createdAt DateTime         @default(now())

  @@index([refereeId])
}

model TeamSheet {
  id          String    @id @default(uuid())
  fixtureId   String
  fixture     Fixture   @relation(fields: [fixtureId], references: [id])
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id])
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries TeamSheetEntry[]

  @@unique([fixtureId, clubId])
  @@index([fixtureId])
}

model TeamSheetEntry {
  id          String        @id @default(uuid())
  teamSheetId String
  teamSheet   TeamSheet     @relation(fields: [teamSheetId], references: [id])
  playerId    String
  player      Player        @relation(fields: [playerId], references: [id])
  role        TeamSheetRole
  isCaptain   Boolean       @default(false)
  // The shirt the player wears in THIS match. Distinct from Player.playerNumber,
  // which is the squad number: a player can be handed a different shirt for a
  // given fixture, and the referee's team sheet must show what is on the pitch.
  jerseyNumber Int?

  @@unique([teamSheetId, playerId])
  @@index([teamSheetId])
}

model DisciplinaryCase {
  id           String              @id @default(uuid())
  playerId     String
  player       Player              @relation(fields: [playerId], references: [id])
  clubId       String
  club         Club                @relation(fields: [clubId], references: [id])
  fixtureId    String?
  fixture      Fixture?            @relation(fields: [fixtureId], references: [id])
  reason       String
  decision     String?             @db.Text
  decisionDate DateTime?
  status       DisciplinaryStatus  @default(OPEN)
  notes        String?             @db.Text
  // Automatic card-driven suspensions reuse this model rather than adding a
  // parallel one. `suspensionType` is null for cases a League Manager opened by
  // hand, and set for the three rules the engine derives from match events
  // (see lib/suspensions.ts). The unique constraint below makes recalculation
  // idempotent — Postgres treats NULLs as distinct, so manual cases never
  // collide with each other or with the automatic ones.
  suspensionType String?
  matchesBanned  Int?
  matchesServed  Int                @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([playerId, fixtureId, suspensionType])
  @@index([playerId])
  @@index([clubId])
  @@index([status])
}

model Announcement {
  id               String                @id @default(uuid())
  title            String
  message          String
  audience         Role?
  priority         AnnouncementPriority  @default(NORMAL)
  featuredImageUrl String?               @db.Text
  // Public news fields — only populated for audience-less (public) stories.
  slug             String?               @unique
  category         String?
  author           String?
  startDate        DateTime              @default(now())
  createdAt        DateTime              @default(now())
  createdById      String?
  createdBy        User?                 @relation(fields: [createdById], references: [id])

  @@index([audience])
  @@index([category])
}

model Sponsor {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  logoUrl     String?  @db.Text
  websiteUrl  String?
  category    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active])
}

model Download {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  fileUrl     String   @db.Text
  category    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(uuid())
  title     String?
  caption   String?  @db.Text
  imageUrl  String   @db.Text
  category  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category])
}

// Key/value store for editable public copy (hero, about, contact, socials),
// so the Platform Owner can change site text without a schema change.
model SiteContent {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  targetId  String?
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([module])
  @@index([userId])
  @@index([createdAt])
}
